                      <label for="${ct.id}" class="text-xs font-semibold ${isChecked ? 'line-through text-slate-500' : 'text-slate-900'} cursor-pointer">${ct.title}</label>
                      <p class="text-[11px] text-slate-500 mt-0.5">${ct.detail}</p>
                    </div>
                  </div>
                  <span class="text-[10px] font-bold px-2 py-0.5 rounded bg-purple-100 text-purple-800">${ct.tag}</span>
                </div>
              </div>
            `;
          });
          contentHtml += `</div></div>`;
        }

        // Add Custom Task Button Footer
        contentHtml += `
          <div class="pt-2 flex justify-end">
            <button onclick="openCustomTaskModal('${month.monthId}')" class="text-xs font-semibold px-3 py-1.5 rounded-lg bg-white border border-slate-200 text-blue-600 hover:bg-blue-50 transition flex items-center gap-1.5">
              <i class="fa-solid fa-plus text-[10px]"></i> Add Task to ${month.title.split(':')[0]}
            </button>
          </div>
        `;

        contentHtml += `</div>`;
        card.innerHTML = headerHtml + contentHtml;
        container.appendChild(card);
      });

      // Search empty state check
      if (searchQuery && matchCount === 0) {
        container.innerHTML = `
          <div class="p-8 text-center bg-white rounded-2xl border border-slate-200 custom-shadow">
            <i class="fa-solid fa-magnifying-glass text-3xl text-slate-300 mb-2"></i>
            <h4 class="font-bold text-slate-800">No matching topics found</h4>
            <p class="text-xs text-slate-500 mt-1">Try searching for generic terms like "SQL", "Excel", "DAX", or "Python".</p>
            <button onclick="clearSearch()" class="mt-3 text-xs font-semibold text-blue-600 hover:underline">Clear Search Filter</button>
          </div>
        `;
      }
    }

    // TOGGLE CHECKBOX TASK
    function toggleTask(id) {
      appState.completed[id] = !appState.completed[id];
      saveState();
      renderMonths();
      renderPillars();

      // Check 100% completion celebration trigger
      const totals = getAllTaskCount();
      if (totals.done === totals.total && totals.total > 0 && !appState.celebrated) {
        appState.celebrated = true;
        saveState();
        setTimeout(() => {
          openCertificateModal();
        }, 400);
      }
    }

    // HELPER: GET TOTAL TASKS
    function getAllTaskCount() {
      let total = 0;
      let done = 0;
      ROADMAP_DATA.forEach(month => {
        month.modules.forEach(m => {
          m.topics.forEach(t => {
            total++;
            if (appState.completed[t.id]) done++;
          });
        });
        const custom = appState.customTasks[month.monthId] || [];
        custom.forEach(c => {
          total++;
          if (appState.completed[c.id]) done++;
        });
      });
      return { total, done };
    }

    // UPDATE METERS & DYNAMIC CAREER RANK
    function updateProgressMeters() {
      const totals = getAllTaskCount();
      const percent = totals.total > 0 ? Math.round((totals.done / totals.total) * 100) : 0;

      // Header Bar & Circle
      document.getElementById('topProgressBar').style.width = percent + '%';
      document.getElementById('statPercentText').innerText = percent + '%';
      document.getElementById('completedCountText').innerText = totals.done;
      document.getElementById('totalCountText').innerText = `/ ${totals.total} Topics Ticked`;
      document.getElementById('circleProgress').setAttribute('stroke-dasharray', `${percent}, 100`);

      // Dynamic Identity Ranks
      let rank = 'Aspiring Business Analyst';
      let sub = 'Master Excel & SQL foundations to kickstart your BA career.';
      
      if (percent >= 95) {
        rank = 'Certified Job-Ready Business Analyst';
        sub = 'Fully equipped with BA Economics, SQL, Python, Power BI, Agile & 3 Portfolio Projects! Ready for applications.';
      } else if (percent >= 76) {
        rank = 'Portfolio-Backed Business Analyst';
        sub = 'All 3 portfolio projects complete. Finalizing resume & daily job application strategy.';
      } else if (percent >= 56) {
        rank = 'Agile & Product Requirements Specialist';
        sub = 'Strong command over BRD/FRD, User Stories, Jira, and Process Diagrams.';
      } else if (percent >= 36) {
        rank = 'Python & BI Insights Analyst';
        sub = 'Proficient in Pandas data manipulation, Star Schema modeling, and DAX dashboard design.';
      } else if (percent >= 16) {
        rank = 'Data & SQL Practitioner';
        sub = 'Excel formulas, SQL Window functions, CTEs, and joins mastered.';
      }

      document.getElementById('rankBadge').innerText = rank;
      document.getElementById('overallRankTitle').innerText = rank;
      document.getElementById('rankSubtitleText').innerText = sub;
      document.getElementById('certVerifiedPercent').innerText = `${percent}% Curriculum Verified`;
    }

    // RENDER 6 PILLAR BARS
    function renderPillars() {
      const container = document.getElementById('pillarProgressContainer');
      container.innerHTML = '';

      ROADMAP_DATA.forEach(month => {
        let monthTopics = [];
        month.modules.forEach(m => { monthTopics = monthTopics.concat(m.topics); });
        const custom = appState.customTasks[month.monthId] || [];
        monthTopics = monthTopics.concat(custom);

        const total = monthTopics.length;
        const done = monthTopics.filter(t => appState.completed[t.id]).length;
        const pct = total > 0 ? Math.round((done / total) * 100) : 0;

        const item = document.createElement('div');
        item.className = 'space-y-1';
        item.innerHTML = `
          <div class="flex items-center justify-between text-xs font-semibold">
            <span class="text-slate-700 truncate">${month.badge}</span>
            <span class="${pct === 100 ? 'text-emerald-600' : 'text-slate-500'} font-bold">${pct}%</span>
          </div>
          <div class="w-full bg-slate-100 h-2 rounded-full overflow-hidden">
            <div class="${pct === 100 ? 'bg-emerald-500' : 'bg-blue-600'} h-2 transition-all duration-500 rounded-full" style="width: ${pct}%"></div>
          </div>
        `;
        container.appendChild(item);
      });
    }

    // PROJECT LINKS SAVE
    function saveProjectLink(key, val) {
      appState.projectLinks[key] = val.trim();
      saveState();
    }

    // LINKEDIN HEADLINE QUICK COPY
    function copyLinkedInHeadline() {
      const text = document.getElementById('linkedinHeadlineText').innerText.trim();
      const temp = document.createElement('textarea');
      temp.value = text;
      document.body.appendChild(temp);
      temp.select();
      document.execCommand('copy');
      document.body.removeChild(temp);

      const btnText = document.getElementById('headlineCopyText');
      const btn = document.getElementById('headlineCopyBtn');
      btnText.innerText = 'Copied!';
      btn.classList.remove('bg-blue-600');
      btn.classList.add('bg-emerald-600');

      setTimeout(() => {
        btnText.innerText = 'Copy Headline';
        btn.classList.remove('bg-emerald-600');
        btn.classList.add('bg-blue-600');
      }, 2000);
    }

    // APPLICATION LOG HANDLERS
    function handleLogSubmit(e) {
      e.preventDefault();
      const comp = document.getElementById('logCompany').value.trim();
      const plat = document.getElementById('logPlatform').value;
      const date = document.getElementById('logDate').value;

      if (!comp) return;

      const log = { id: Date.now(), company: comp, platform: plat, date: date };
      appState.logs.unshift(log);
      saveState();
      renderLogs();

      document.getElementById('logCompany').value = '';
    }

    function deleteLog(id) {
      appState.logs = appState.logs.filter(l => l.id !== id);
      saveState();
      renderLogs();
    }

    function renderLogs() {
      const container = document.getElementById('appLogContainer');
      const badge = document.getElementById('appLogBadge');
      badge.innerText = `${appState.logs.length} Logged`;
      container.innerHTML = '';

      if (appState.logs.length === 0) {
        container.innerHTML = `<p class="text-xs text-slate-400 italic text-center py-3">No applications logged yet today.</p>`;
        return;
      }

      appState.logs.forEach(l => {
        const d = document.createElement('div');
        d.className = 'p-2 rounded-xl bg-slate-50 border border-slate-200 flex items-center justify-between text-xs';
        d.innerHTML = `
          <div>
            <span class="font-bold text-slate-800">${l.company}</span>
            <div class="flex items-center gap-1.5 text-[10px] text-slate-500 mt-0.5">
              <span class="font-semibold text-blue-600">${l.platform}</span> &bull; <span>${l.date}</span>
            </div>
          </div>
          <button onclick="deleteLog(${l.id})" class="text-slate-400 hover:text-red-500 p-1">
            <i class="fa-solid fa-trash-can text-xs"></i>
          </button>
        `;
        container.appendChild(d);
      });
    }

    // NOTES SAVE
    function saveNotes() {
      appState.notes = document.getElementById('studyNotes').value;
      saveState();
    }

    function saveCandidateName(val) {
      appState.candidateName = val;
      saveState();
    }

    // EXPAND & COLLAPSE ALL
    function toggleMonthExpand(mId) {
      appState.expandedMonths[mId] = !appState.expandedMonths[mId];
      saveState();
      renderMonths();
    }

    function toggleAllMonths(expand) {
      ROADMAP_DATA.forEach(m => {
        appState.expandedMonths[m.monthId] = expand;
      });
      saveState();
      renderMonths();
    }

    // SEARCH & FILTERS
    function setFilter(f) {
      currentFilter = f;
      document.querySelectorAll('.filter-btn').forEach(b => {
        b.classList.remove('bg-white', 'text-blue-600', 'shadow-sm');
        b.classList.add('text-slate-600');
      });
      const activeBtn = document.getElementById('filter' + f.charAt(0).toUpperCase() + f.slice(1));
      if (activeBtn) {
        activeBtn.classList.add('bg-white', 'text-blue-600', 'shadow-sm');
        activeBtn.classList.remove('text-slate-600');
      }
      renderMonths();
    }

    function handleSearch(val) {
      searchQuery = val.trim();
      const clearBtn = document.getElementById('clearSearchBtn');
      if (searchQuery) clearBtn.classList.remove('hidden');
      else clearBtn.classList.add('hidden');
      renderMonths();
    }

    function clearSearch() {
      document.getElementById('searchInput').value = '';
      searchQuery = '';
      document.getElementById('clearSearchBtn').classList.add('hidden');
      renderMonths();
    }

    // CERTIFICATE MODAL & CONFETTI
    function openCertificateModal() {
      document.getElementById('printableCertificateModal').classList.remove('hidden');
      triggerConfetti();
    }

    function closeCertificateModal() {
      document.getElementById('printableCertificateModal').classList.add('hidden');
    }

    function triggerConfetti() {
      if (typeof confetti === 'function') {
        confetti({ particleCount: 120, spread: 80, origin: { y: 0.6 } });
      }
    }

    // CUSTOM TASK MODAL
    function openCustomTaskModal(monthId) {
      document.getElementById('customTaskMonthId').value = monthId;
      document.getElementById('customTaskModal').classList.remove('hidden');
    }

    function closeCustomTaskModal() {
      document.getElementById('customTaskModal').classList.add('hidden');
    }

    function handleAddCustomTask(e) {
      e.preventDefault();
      const monthId = document.getElementById('customTaskMonthId').value;
      const title = document.getElementById('customTaskTitle').value.trim();
      const detail = document.getElementById('customTaskDetail').value.trim() || 'Custom roadmap goal.';
      const tag = document.getElementById('customTaskTag').value.trim() || 'Custom';

      if (!title) return;

      if (!appState.customTasks[monthId]) appState.customTasks[monthId] = [];

      appState.customTasks[monthId].push({
        id: 'ct_' + Date.now(),
        title: title,
        detail: detail,
        tag: tag
      });

      saveState();
      renderMonths();
      renderPillars();
      closeCustomTaskModal();

      document.getElementById('customTaskTitle').value = '';
      document.getElementById('customTaskDetail').value = '';
      document.getElementById('customTaskTag').value = '';
    }

    // EXPORT & IMPORT DATA JSON BACKUP
    function exportDataJSON() {
      const dataStr = "data:text/json;charset=utf-8," + encodeURIComponent(JSON.stringify(appState, null, 2));
      const downloadAnchor = document.createElement('a');
      downloadAnchor.setAttribute("href", dataStr);
      downloadAnchor.setAttribute("download", `BA_Roadmap_Backup_${new Date().toISOString().slice(0,10)}.json`);
      document.body.appendChild(downloadAnchor);
      downloadAnchor.click();
      downloadAnchor.remove();
    }

    function importDataJSON(e) {
      const fileReader = new FileReader();
      fileReader.onload = function(event) {
        try {
          const parsed = JSON.parse(event.target.result);
          if (parsed && typeof parsed === 'object') {
            appState = Object.assign(appState, parsed);
            saveState();
            renderApp();
            alert('Roadmap progress successfully restored!');
          }
        } catch(err) {
          alert('Invalid JSON backup file format.');
        }
      };
      if (e.target.files[0]) {
        fileReader.readAsText(e.target.files[0]);
      }
    }

    // RESET CONFIRMATION
    function confirmReset() {
      if (confirm('Are you sure you want to reset all progress, tasks, logs, and notes?')) {
        appState = {
          completed: {},
          projectLinks: {},
          customTasks: {},
          logs: [],
          notes: '',
          candidateName: 'M Ahammad Irfan',
          celebrated: false,
          expandedMonths: { m1: true, m2: true, m3: true, m4: true, m5: true, m6: true }
        };
        localStorage.removeItem('ba_roadmap_master_state');
        document.getElementById('studyNotes').value = '';
        renderApp();
      }
    }
  </script>
</body>
</html>
