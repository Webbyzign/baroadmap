<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Business Analyst 6-Month Roadmap & Career Readiness Tracker</title>
  <!-- Tailwind CSS CDN -->
  <script src="https://cdn.tailwindcss.com"></script>
  <script>
    tailwind.config = {
      theme: {
        extend: {
          colors: {
            brand: {
              50: '#eff6ff',
              100: '#dbeafe',
              500: '#3b82f6',
              600: '#2563eb',
              700: '#1d4ed8',
              800: '#1e40af',
            },
            accent: {
              500: '#10b981',
              600: '#059669',
              700: '#047857'
            }
          },
          fontFamily: {
            sans: ['Inter', 'system-ui', 'sans-serif'],
            serif: ['Playfair Display', 'Georgia', 'serif']
          }
        }
      }
    }
  </script>
  <!-- Google Fonts -->
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800&family=Playfair+Display:wght@600;700;800&display=swap" rel="stylesheet">
  <!-- FontAwesome Icons -->
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
  <!-- Canvas Confetti CDN -->
  <script src="https://cdn.jsdelivr.net/npm/canvas-confetti@1.6.0/dist/confetti.browser.min.js"></script>
  
  <style>
    body {
      background-color: #f8fafc;
      color: #0f172a;
    }
    .custom-shadow {
      box-shadow: 0 4px 20px -2px rgba(15, 23, 42, 0.05), 0 2px 6px -1px rgba(15, 23, 42, 0.03);
    }
    .cert-frame {
      border: 10px solid #ffffff;
      outline: 2px solid #cbd5e1;
      box-shadow: 0 0 0 6px #2563eb, 0 20px 25px -5px rgba(0, 0, 0, 0.1);
    }
    .task-item:hover {
      background-color: #f1f5f9;
    }
    /* Printable Certificate Styles */
    @media print {
      body * {
        visibility: hidden;
      }
      #printableCertificateModal, #printableCertificateModal * {
        visibility: visible;
      }
      #printableCertificateModal {
        position: absolute;
        left: 0;
        top: 0;
        width: 100%;
        height: 100%;
        background: white !important;
        display: flex !important;
        justify-content: center;
        align-items: center;
        padding: 0;
        margin: 0;
      }
      .no-print {
        display: none !important;
      }
    }
  </style>
</head>
<body class="min-h-screen bg-slate-50 text-slate-900 font-sans antialiased pb-16 selection:bg-blue-100 selection:text-blue-900">

  <!-- TOP HEADER & NAVBAR -->
  <header class="border-b border-slate-200 sticky top-0 bg-white/95 backdrop-blur-md z-30 shadow-sm">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-3.5 flex flex-wrap items-center justify-between gap-4">
      
      <!-- Brand & Title -->
      <div class="flex items-center space-x-3">
        <div class="w-10 h-10 rounded-xl bg-blue-600 flex items-center justify-center text-white font-extrabold text-xl shadow-md shadow-blue-500/20">
          BA
        </div>
        <div>
          <div class="flex items-center gap-2">
            <h1 class="text-base sm:text-lg font-bold text-slate-900 tracking-tight leading-none">
              Business Analyst Career Roadmap
            </h1>
            <span id="rankBadge" class="text-xs px-2.5 py-0.5 rounded-full font-semibold bg-blue-50 text-blue-700 border border-blue-200">
              Aspiring Business Analyst
            </span>
          </div>
          <p class="text-xs text-slate-500 mt-0.5">6-Month Complete Curriculum & Career Readiness Tracker</p>
        </div>
      </div>

      <!-- Action Toolbar Buttons -->
      <div class="flex items-center flex-wrap gap-2">
        <button onclick="openCertificateModal()" class="inline-flex items-center gap-1.5 text-xs font-semibold px-3 py-2 rounded-lg bg-emerald-50 text-emerald-700 hover:bg-emerald-100 border border-emerald-200 transition">
          <i class="fa-solid fa-award text-emerald-600"></i>
          <span>BA Readiness Certificate</span>
        </button>
        
        <!-- JSON Backup Controls -->
        <button onclick="exportDataJSON()" class="inline-flex items-center gap-1.5 text-xs font-medium px-2.5 py-2 rounded-lg text-slate-600 bg-slate-100 hover:bg-slate-200 transition" title="Export Backup JSON">
          <i class="fa-solid fa-download text-slate-500"></i>
          <span class="hidden sm:inline">Export</span>
        </button>
        <label class="inline-flex items-center gap-1.5 text-xs font-medium px-2.5 py-2 rounded-lg text-slate-600 bg-slate-100 hover:bg-slate-200 transition cursor-pointer" title="Import Backup JSON">
          <i class="fa-solid fa-upload text-slate-500"></i>
          <span class="hidden sm:inline">Import</span>
          <input type="file" id="importFileInput" onchange="importDataJSON(event)" accept=".json" class="hidden">
        </label>

        <button onclick="confirmReset()" class="inline-flex items-center gap-1 text-xs font-medium px-2.5 py-2 rounded-lg text-slate-500 hover:text-red-600 hover:bg-red-50 border border-transparent transition" title="Reset all progress">
          <i class="fa-solid fa-rotate-left"></i>
          <span class="hidden md:inline">Reset</span>
        </button>
      </div>
    </div>

    <!-- Live Overall Progress Bar -->
    <div class="w-full bg-slate-100 h-1.5 overflow-hidden">
      <div id="topProgressBar" class="bg-gradient-to-r from-blue-600 via-indigo-600 to-emerald-500 h-1.5 transition-all duration-500" style="width: 0%"></div>
    </div>
  </header>

  <!-- MAIN CONTAINER -->
  <main class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8 space-y-8">

    <!-- HERO DASHBOARD STATS CARD -->
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-6">
      
      <!-- Primary Meter Card (Left 5 Cols) -->
      <div class="lg:col-span-5 p-6 rounded-2xl border border-slate-200 bg-white custom-shadow flex flex-col justify-between">
        <div class="flex items-center justify-between mb-4">
          <div>
            <span class="text-xs font-semibold uppercase tracking-wider text-slate-400">Total Completion</span>
            <h2 id="overallRankTitle" class="text-xl font-extrabold text-slate-900 mt-0.5">Aspiring Business Analyst</h2>
          </div>
          <div class="w-12 h-12 rounded-xl bg-blue-50 text-blue-600 flex items-center justify-center font-bold text-lg">
            <i class="fa-solid fa-chart-pie"></i>
          </div>
        </div>

        <div class="flex items-center gap-6 my-2">
          <!-- Circular SVG Progress -->
          <div class="relative w-24 h-24 flex-shrink-0 flex items-center justify-center">
            <svg class="w-24 h-24 transform -rotate-90" viewBox="0 0 36 36">
              <path class="text-slate-100" stroke-width="3" stroke="currentColor" fill="none" d="M18 2.0845 a 15.9155 15.9155 0 0 1 0 31.831 a 15.9155 15.9155 0 0 1 0 -31.831" />
              <path id="circleProgress" class="text-blue-600 transition-all duration-700 ease-out" stroke-dasharray="0, 100" stroke-width="3.5" stroke-linecap="round" stroke="currentColor" fill="none" d="M18 2.0845 a 15.9155 15.9155 0 0 1 0 31.831 a 15.9155 15.9155 0 0 1 0 -31.831" />
            </svg>
            <span id="statPercentText" class="absolute text-xl font-black text-slate-900">0%</span>
          </div>

          <div class="space-y-1">
            <div class="flex items-baseline gap-1.5">
              <span id="completedCountText" class="text-2xl font-black text-slate-900">0</span>
              <span id="totalCountText" class="text-xs font-semibold text-slate-500">/ 0 Topics Ticked</span>
            </div>
            <p id="rankSubtitleText" class="text-xs text-slate-500 leading-relaxed">
              Master Excel & SQL foundations to kickstart your journey toward becoming a Business Analyst.
            </p>
          </div>
        </div>

        <!-- Target Roles Footer -->
        <div class="mt-4 pt-3 border-t border-slate-100 flex items-center justify-between text-xs">
          <span class="text-slate-400 font-medium">Target Roles:</span>
          <span class="font-semibold text-slate-700">Associate BA &bull; Junior BA &bull; Product Analyst &bull; BI Analyst</span>
        </div>
      </div>

      <!-- Skill Pillar Breakdowns (Right 7 Cols) -->
      <div class="lg:col-span-7 p-6 rounded-2xl border border-slate-200 bg-white custom-shadow flex flex-col justify-between">
        <div class="flex items-center justify-between mb-3">
          <h3 class="text-xs font-bold uppercase tracking-wider text-slate-400">6 Core Skill Pillars Breakdown</h3>
          <span class="text-xs text-blue-600 font-medium"><i class="fa-solid fa-arrows-rotate mr-1"></i>Live Syncing</span>
        </div>

        <div class="grid grid-cols-1 sm:grid-cols-2 gap-x-6 gap-y-3.5" id="pillarProgressContainer">
          <!-- Rendered dynamically -->
        </div>

        <div class="mt-4 pt-3 border-t border-slate-100 flex items-center justify-between text-xs text-slate-500">
          <span>Degree Foundation: <strong class="text-slate-800">BA Economics</strong></span>
          <span>Proof of Work: <strong class="text-slate-800">3 Portfolio Projects</strong></span>
        </div>
      </div>

    </div>

    <!-- CONTROLS & SEARCH BAR TOOLBAR -->
    <div class="p-4 rounded-2xl bg-white border border-slate-200 custom-shadow flex flex-wrap items-center justify-between gap-4">
      
      <!-- Filter Tabs -->
      <div class="flex items-center bg-slate-100 p-1 rounded-xl">
        <button onclick="setFilter('all')" id="filterAll" class="filter-btn text-xs font-semibold px-3.5 py-1.5 rounded-lg transition bg-white text-blue-600 shadow-sm">
          All Topics
        </button>
        <button onclick="setFilter('pending')" id="filterPending" class="filter-btn text-xs font-semibold px-3.5 py-1.5 rounded-lg text-slate-600 hover:text-slate-900 transition">
          Pending
        </button>
        <button onclick="setFilter('completed')" id="filterCompleted" class="filter-btn text-xs font-semibold px-3.5 py-1.5 rounded-lg text-slate-600 hover:text-slate-900 transition">
          Completed
        </button>
      </div>

      <!-- Search Input -->
      <div class="relative flex-1 max-w-md">
        <i class="fa-solid fa-magnifying-glass absolute left-3.5 top-1/2 -translate-y-1/2 text-slate-400 text-xs"></i>
        <input type="text" id="searchInput" oninput="handleSearch(this.value)" placeholder="Search functions (XLOOKUP, CTE, DAX, BRD, User Stories, Pandas)..." 
          class="w-full text-xs pl-9 pr-8 py-2 rounded-xl border border-slate-200 focus:outline-none focus:border-blue-500 focus:ring-1 focus:ring-blue-500 bg-slate-50/50">
        <button onclick="clearSearch()" id="clearSearchBtn" class="hidden absolute right-3 top-1/2 -translate-y-1/2 text-slate-400 hover:text-slate-600 text-xs">
          <i class="fa-solid fa-circle-xmark"></i>
        </button>
      </div>

      <!-- Collapse/Expand All Buttons -->
      <div class="flex items-center gap-2">
        <button onclick="toggleAllMonths(true)" class="text-xs font-medium px-3 py-1.5 rounded-lg border border-slate-200 hover:bg-slate-50 text-slate-600 transition">
          <i class="fa-solid fa-folder-open mr-1 text-slate-400"></i> Expand All
        </button>
        <button onclick="toggleAllMonths(false)" class="text-xs font-medium px-3 py-1.5 rounded-lg border border-slate-200 hover:bg-slate-50 text-slate-600 transition">
          <i class="fa-solid fa-folder mr-1 text-slate-400"></i> Collapse
        </button>
      </div>

    </div>

    <!-- MAIN CURRICULUM LAYOUT GRID (Left: 6 Months Roadmap | Right: Sidebar Tools) -->
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-8">
      
      <!-- LEFT ROADMAP COLUMN (8 Cols) -->
      <div class="lg:col-span-8 space-y-6" id="monthsContainer">
        <!-- Rendered dynamically -->
      </div>

      <!-- RIGHT SIDEBAR COLUMN (4 Cols) -->
      <div class="lg:col-span-4 space-y-6">

        <!-- Quick Headline Tool Widget -->
        <div class="p-5 rounded-2xl border border-blue-200 bg-blue-50/40 custom-shadow space-y-3">
          <div class="flex items-center justify-between">
            <h3 class="text-xs font-extrabold uppercase tracking-wider text-blue-800 flex items-center gap-1.5">
              <i class="fa-brands fa-linkedin text-blue-600 text-sm"></i> Month 6 Headline Tool
            </h3>
            <span class="text-[10px] bg-blue-100 text-blue-700 font-bold px-2 py-0.5 rounded-full">Week 2</span>
          </div>
          <p class="text-xs text-slate-600">Copy exact ATS-optimized LinkedIn headline for recruiter visibility:</p>
          <div class="p-2.5 bg-white rounded-xl border border-blue-100 font-mono text-xs text-slate-800 leading-relaxed select-all" id="linkedinHeadlineText">
            Aspiring Business & Product Analyst | BA Economics | SQL, Python, Power BI, Agile & BRD
          </div>
          <button onclick="copyLinkedInHeadline()" id="headlineCopyBtn" class="w-full py-2 px-3 bg-blue-600 hover:bg-blue-700 text-white rounded-xl text-xs font-semibold transition flex items-center justify-center gap-2 shadow-sm">
            <i class="fa-regular fa-copy"></i>
            <span id="headlineCopyText">Copy Headline</span>
          </button>
        </div>

        <!-- Application Tracker & Scenario Log -->
        <div class="p-5 rounded-2xl border border-slate-200 bg-white custom-shadow space-y-4">
          <div class="flex items-center justify-between">
            <h3 class="text-sm font-bold text-slate-900 flex items-center gap-2">
              <i class="fa-solid fa-paper-plane text-emerald-600 text-xs"></i>
              Daily Job Application Log
            </h3>
            <span id="appLogBadge" class="text-[10px] font-bold px-2 py-0.5 rounded-full bg-emerald-50 text-emerald-700 border border-emerald-200">0 Logged</span>
          </div>

          <form onsubmit="handleLogSubmit(event)" class="space-y-2.5 bg-slate-50 p-3 rounded-xl border border-slate-200">
            <div>
              <label class="block text-[11px] font-semibold text-slate-600 mb-1">Company & Role</label>
              <input type="text" id="logCompany" required placeholder="e.g. Swiggy - Junior BA" class="w-full text-xs px-2.5 py-1.5 rounded-lg border border-slate-300 focus:outline-none focus:border-blue-500 bg-white">
            </div>
            <div class="grid grid-cols-2 gap-2">
              <div>
                <label class="block text-[11px] font-semibold text-slate-600 mb-1">Platform</label>
                <select id="logPlatform" class="w-full text-xs px-2 py-1.5 rounded-lg border border-slate-300 focus:outline-none focus:border-blue-500 bg-white">
                  <option value="LinkedIn">LinkedIn</option>
                  <option value="Naukri">Naukri</option>
                  <option value="Wellfound">Wellfound</option>
                  <option value="Internshala">Internshala</option>
                  <option value="Direct Site">Direct Site</option>
                </select>
              </div>
              <div>
                <label class="block text-[11px] font-semibold text-slate-600 mb-1">Date</label>
                <input type="text" id="logDate" class="w-full text-xs px-2 py-1.5 rounded-lg border border-slate-300 bg-slate-100 text-slate-600 font-mono" readonly>
              </div>
            </div>
            <button type="submit" class="w-full text-xs font-semibold py-1.5 bg-slate-900 hover:bg-slate-800 text-white rounded-lg transition flex items-center justify-center gap-1">
              <i class="fa-solid fa-plus text-[10px]"></i> Record Application
            </button>
          </form>

          <div id="appLogContainer" class="space-y-2 max-h-56 overflow-y-auto pr-1">
            <!-- Rendered dynamically -->
          </div>
        </div>

        <!-- Personal Study Notes & SQL Snippets -->
        <div class="p-5 rounded-2xl border border-slate-200 bg-white custom-shadow space-y-3">
          <div class="flex items-center justify-between">
            <h3 class="text-sm font-bold text-slate-900 flex items-center gap-2">
              <i class="fa-regular fa-note-sticky text-amber-500"></i>
              SQL & Interview Scratchpad
            </h3>
            <span class="text-[10px] text-emerald-600 font-medium flex items-center gap-1">
              <i class="fa-solid fa-cloud-arrow-up"></i> Auto-saved
            </span>
          </div>
          <p class="text-xs text-slate-500">Keep interview formulas, SQL CTE templates, or BRD outlines handy.</p>
          <textarea id="studyNotes" oninput="saveNotes()" rows="6" placeholder="Example SQL CTE syntax:&#10;WITH RegionalSales AS (&#10;  SELECT region, SUM(amount) AS total FROM sales GROUP BY region&#10;)&#10;SELECT * FROM RegionalSales WHERE total > 10000;" class="w-full text-xs p-3 rounded-xl border border-slate-200 focus:outline-none focus:border-blue-500 font-mono text-slate-800 bg-slate-50/50 leading-relaxed resize-y"></textarea>
        </div>

        <!-- Quick Target Platform Links -->
        <div class="p-5 rounded-2xl border border-slate-200 bg-white custom-shadow space-y-3">
          <h3 class="text-xs font-bold uppercase tracking-wider text-slate-400">Direct Application Channels</h3>
          <div class="grid grid-cols-2 gap-2 text-xs">
            <a href="https://www.linkedin.com/jobs/" target="_blank" class="p-2 rounded-xl border border-slate-200 hover:bg-blue-50 hover:border-blue-200 font-semibold text-slate-700 flex items-center gap-2 transition">
              <i class="fa-brands fa-linkedin text-blue-600 text-sm"></i> LinkedIn
            </a>
            <a href="https://www.naukri.com/" target="_blank" class="p-2 rounded-xl border border-slate-200 hover:bg-blue-50 hover:border-blue-200 font-semibold text-slate-700 flex items-center gap-2 transition">
              <i class="fa-solid fa-briefcase text-blue-500 text-sm"></i> Naukri
            </a>
            <a href="https://wellfound.com/" target="_blank" class="p-2 rounded-xl border border-slate-200 hover:bg-purple-50 hover:border-purple-200 font-semibold text-slate-700 flex items-center gap-2 transition">
              <i class="fa-solid fa-rocket text-purple-600 text-sm"></i> Wellfound
            </a>
            <a href="https://internshala.com/" target="_blank" class="p-2 rounded-xl border border-slate-200 hover:bg-emerald-50 hover:border-emerald-200 font-semibold text-slate-700 flex items-center gap-2 transition">
              <i class="fa-solid fa-graduation-cap text-emerald-600 text-sm"></i> Internshala
            </a>
          </div>
        </div>

      </div>

    </div>

  </main>

  <!-- ACHIEVEMENT CERTIFICATE MODAL -->
  <div id="printableCertificateModal" class="fixed inset-0 bg-slate-900/70 backdrop-blur-sm z-50 flex items-center justify-center p-4 hidden">
    <div class="bg-white rounded-3xl max-w-3xl w-full p-6 sm:p-8 relative custom-shadow border border-slate-200 max-h-[95vh] overflow-y-auto">
      
      <!-- Close Button (Hidden during print) -->
      <button onclick="closeCertificateModal()" class="no-print absolute top-4 right-4 text-slate-400 hover:text-slate-600 p-2 rounded-full hover:bg-slate-100 transition">
        <i class="fa-solid fa-xmark text-xl"></i>
      </button>

      <!-- Certificate Frame -->
      <div id="printableCertificate" class="cert-frame p-6 sm:p-10 text-center bg-white rounded-2xl relative space-y-5">
        
        <!-- Header Badge -->
        <div class="w-20 h-20 rounded-full bg-gradient-to-br from-blue-600 to-indigo-700 text-white mx-auto flex items-center justify-center text-3xl shadow-xl shadow-blue-500/30">
          <i class="fa-solid fa-award"></i>
        </div>

        <div>
          <p class="text-xs font-black uppercase tracking-widest text-blue-600">Official Certificate of Career Readiness</p>
          <h2 class="text-2xl sm:text-4xl font-extrabold text-slate-900 mt-1 font-serif">Certified Business Analyst</h2>
          <p class="text-xs text-slate-500 mt-1">Ready for Associate BA, Junior BA, Product & BI Analyst Roles</p>
        </div>

        <p class="text-xs text-slate-400 uppercase tracking-widest">This certifies that</p>
        
        <!-- Candidate Name Input Field (Editable Inline) -->
        <div class="inline-block border-b-2 border-slate-400 hover:border-blue-600 transition px-6 py-1">
          <input type="text" id="certCandidateName" value="M Ahammad Irfan" oninput="saveCandidateName(this.value)" class="text-center font-bold text-xl sm:text-2xl text-slate-900 focus:outline-none bg-transparent" title="Click to edit your name">
        </div>
        <p class="text-[10px] text-slate-400 italic no-print">^ Click above name to customize for official export</p>

        <p class="text-xs text-slate-600 max-w-xl mx-auto leading-relaxed">
          Has successfully executed the complete 6-Month Business Analyst curriculum, demonstrating verified technical proficiency across Advanced Excel, SQL Databases, Python Data Analytics, Power BI Dashboards, Agile & BRD Documentation, and 3 End-to-End Portfolio Projects.
        </p>

        <!-- Skill Badges Grid -->
        <div class="flex flex-wrap justify-center gap-2 py-2">
          <span class="text-xs font-bold px-3 py-1 bg-slate-100 text-slate-800 rounded-lg border border-slate-200">BA Economics</span>
          <span class="text-xs font-bold px-3 py-1 bg-blue-50 text-blue-800 rounded-lg border border-blue-200">SQL & Window Functions</span>
          <span class="text-xs font-bold px-3 py-1 bg-amber-50 text-amber-900 rounded-lg border border-amber-200">Python Pandas & NumPy</span>
          <span class="text-xs font-bold px-3 py-1 bg-yellow-50 text-yellow-900 rounded-lg border border-yellow-200">Power BI & DAX</span>
          <span class="text-xs font-bold px-3 py-1 bg-purple-50 text-purple-900 rounded-lg border border-purple-200">Agile, Jira & BRD/FRD</span>
          <span class="text-xs font-bold px-3 py-1 bg-emerald-50 text-emerald-900 rounded-lg border border-emerald-200">3 Portfolio Projects</span>
        </div>

        <!-- Footer Verification Info -->
        <div class="pt-6 border-t border-slate-200 flex items-center justify-between text-left text-xs">
          <div>
            <p class="font-extrabold text-slate-900">Curriculum Completion</p>
            <p class="text-emerald-600 font-bold flex items-center gap-1.5 mt-0.5">
              <i class="fa-solid fa-circle-check"></i> <span id="certVerifiedPercent">100% Curriculum Verified</span>
            </p>
          </div>
          <div class="text-right">
            <p class="font-extrabold text-slate-900" id="certDateText">Date: Verified</p>
            <p class="text-slate-500 mt-0.5">Status: Job Applications Active</p>
          </div>
        </div>

      </div>

      <!-- Action Footer (Hidden in print) -->
      <div class="mt-6 flex items-center justify-between gap-3 no-print">
        <button onclick="triggerConfetti()" class="text-xs font-semibold px-4 py-2 bg-slate-100 hover:bg-slate-200 text-slate-700 rounded-xl transition flex items-center gap-2">
          <i class="fa-solid fa-wand-magic-sparkles text-purple-600"></i> Celebrate Confetti
        </button>
        <div class="flex items-center gap-2">
          <button onclick="window.print()" class="text-xs font-bold px-4 py-2.5 bg-blue-600 hover:bg-blue-700 text-white rounded-xl transition shadow-md flex items-center gap-2">
            <i class="fa-solid fa-print"></i> Print / Save PDF
          </button>
        </div>
      </div>

    </div>
  </div>

  <!-- ADD CUSTOM TASK MODAL -->
  <div id="customTaskModal" class="fixed inset-0 bg-slate-900/50 backdrop-blur-sm z-50 flex items-center justify-center p-4 hidden">
    <div class="bg-white rounded-2xl max-w-md w-full p-6 custom-shadow border border-slate-200">
      <div class="flex items-center justify-between mb-4">
        <h3 class="font-bold text-slate-900 text-base">Add Custom Topic to Roadmap</h3>
        <button onclick="closeCustomTaskModal()" class="text-slate-400 hover:text-slate-600 p-1">
